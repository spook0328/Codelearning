<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>刪除學生資料</title>
    <meta name="author" content="Eric Wong" />
  </head>
  <body>
    <!-- 瀏覽器沒有辦法做get post 之外的功能(put patch delete...) 
     因此要新增套件去完成它-->
    <form
      action="/students/<%= foundStudent._id %>?_method=DELETE"
      method="POST"
    >
      <button>確認刪除</button>
    </form>
    <a href="/students">回到首頁</a>
  </body>
</html>
