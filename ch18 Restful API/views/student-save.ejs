<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>新增學生</title>
    <meta name="author" content="Eric Wong" />
    <style>
      table,
      tr,
      td {
        border: 1px solid black;
      }
    </style>
  </head>
  <body>
    <h1>成功新增學生 !!</h1>
    <p>以下為成功新增的學生資料</p>
    <table>
      <tr>
        <td>學生id</td>
        <td><%= saveStudent._id %></td>
      </tr>
      <tr>
        <td>名稱</td>
        <td><%= saveStudent.name %></td>
      </tr>
      <tr>
        <td>年齡</td>
        <td><%= saveStudent.age %></td>
      </tr>
      <tr>
        <td>merit獎學金</td>
        <td><%= saveStudent.scholarship.merit %></td>
      </tr>
      <tr>
        <td>other獎學金</td>
        <td><%= saveStudent.scholarship.other %></td>
      </tr>
    </table>

    <a href="/students">回到首頁</a>
  </body>
</html>
